[server]
url = https://signage.example.com
player_key = replace-me

[output]
address = 239.1.1.10          ; UDP multicast group (a unicast IP also works)
port = 1234
ttl = 4
interface =                   ; optional source IP for multicast
resolution = 1920x1080        ; 1080p ≈ 75 % of one core on a Celeron 3965U; 1280x720 ≈ 40 %
fps = 30
video_codec = mpeg2           ; mpeg2 (default) or h264 (libx264, more CPU)
video_bitrate_kbps = 12000    ; MPEG-2 CBR; 8000 for 720p
audio_codec = mp2             ; mp2 (default) or aac
audio_bitrate_kbps = 192
mux_rate_kbps = 14000         ; CBR transport stream for modulators (> video + audio + overhead); 10000 for 720p
service_name = In-House
service_provider = Caritech
service_id = 1
pmt_pid = 4096
video_pid = 256               ; audio PID is video_pid + 1

[render]
display = :99
render_port = 8089
threads = 2                   ; encoder threads
