          "speed": 140,
          "style": {
            "fontSize": 48,
            "color": "#ffd166",
            "padding": 0,
            "fontFamily": "Inter"
          }
        }
      ],
      "pages": [
        {
          "id": "main",
          "name": "Main",
          "zones": [
            "logo",
            "welcome",
            "clock",
            "date",
            "hero",
            "tickerbg",
            "ticker"
          ],
          "duration_s": 15
        }
      ]
    }
  },
