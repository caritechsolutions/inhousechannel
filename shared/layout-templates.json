          "style": {
            "fontSize": 44,
            "color": "#ffffff",
            "align": "center",
            "valign": "middle",
            "fontFamily": "Inter"
          }
        },
        {
          "id": "tickerbg",
          "type": "shape",
          "x": 0,
          "y": 960,
          "w": 1920,
          "h": 120,
          "shape": "rect",
          "fill": "rgba(0,0,0,0.45)"
        },
        {
          "id": "ticker",
          "type": "ticker",
          "x": 0,
          "y": 960,
          "w": 1920,
          "h": 120,
          "items": [
            "Breakfast is served 7:00 – 10:30 in the restaurant",
            "Pool and gym open 6:00 – 22:00",
